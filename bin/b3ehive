#!/bin/bash
# b3ehive - compete-oriented CLI entry point

set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TASK="${1:-}"
readonly WORKSPACE="${SCRIPT_DIR}/workspace"

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

log_info() { echo -e "${BLUE}[b3ehive]${NC} $1"; }
log_success() { echo -e "${GREEN}[b3ehive]${NC} $1"; }
log_error() { echo -e "${RED}[b3ehive]${NC} $1"; }

if [[ -z "$TASK" ]]; then
  log_error "Usage: b3ehive \"Your task description\""
  log_error "Example: b3ehive \"Implement HTTP retry with exponential backoff\""
  exit 1
fi

rm -rf "$WORKSPACE"
mkdir -p "$WORKSPACE"

log_info "Task: $TASK"
log_info "Running compete-cron-builder three_way_challenge..."

python3 "${SCRIPT_DIR}/compete-cron-builder/scripts/compete_cron_builder.py" \
  --task "$TASK" \
  --output "$WORKSPACE" \
  --budget-workers 3 \
  --competition-shape three_way_challenge \
  --artifact-layout old_three_way \
  --runner mock \
  --min-free-gb "${B3EHIVE_MIN_FREE_GB:-0}"

if [[ ! -f "${WORKSPACE}/compete_manifest.json" ]]; then
  log_error "compete_manifest.json missing"
  exit 1
fi

if [[ ! -f "${WORKSPACE}/best_run.txt" ]]; then
  log_error "best_run.txt missing"
  exit 1
fi

for candidate in run_a run_b run_c; do
  impl_dir="${WORKSPACE}/${candidate}/implementation"
  if [[ ! -f "${impl_dir}/result.md" ]] ||
     [[ ! -f "${impl_dir}/verification.md" ]] ||
     [[ ! -f "${impl_dir}/critique_round_1.md" ]] ||
     [[ ! -f "${impl_dir}/update_round_1.md" ]] ||
     [[ ! -f "${impl_dir}/critique_round_2.md" ]] ||
     [[ ! -f "${impl_dir}/final_repair.md" ]]; then
    log_error "${candidate} old_three_way artifact layout is incomplete"
    exit 1
  fi
done

log_success "b3ehive compete run complete"
log_info "Output: ${WORKSPACE}"
log_info "Selected: $(cat "${WORKSPACE}/best_run.txt")"
